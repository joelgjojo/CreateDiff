# ==============================================================================
# CreateDiff Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# NOTE: Never commit .env to version control!
# ==============================================================================

# Centralized API Base URL for CreateDiff AI Studio
# Defaults to production HTTPS endpoint: https://api.creatediff.com
#
# Custom backend for physical device or cloud deployment:
# flutter run --dart-define=API_BASE_URL=https://your-backend.onrender.com
#
# Local development backend:
# flutter run --dart-define=API_BASE_URL=http://localhost:8000
API_BASE_URL=https://api.creatediff.com

# Optional Supabase Authentication (Flutter Public Keys Only - Never Service Role!)
# flutter run --dart-define=SUPABASE_URL=https://<project>.supabase.co --dart-define=SUPABASE_ANON_KEY=<anon_key>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your_supabase_anon_public_key>
