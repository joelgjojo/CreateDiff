# ==============================================================================
# CreateDiff FastAPI Backend Environment Configuration
# ==============================================================================

# Server Environment (development | staging | production)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Groq AI Configuration (Server-Side Only - Never Exposed to Flutter Client)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Security & CORS (Comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# In-Memory IP Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Request Limits
MAX_REQUEST_BODY_BYTES=65536
MAX_PROMPT_LENGTH=2000

# Groq HTTP Client Timeouts (seconds)
GROQ_CONNECT_TIMEOUT=10.0
GROQ_READ_TIMEOUT=35.0
GROQ_TOTAL_TIMEOUT=45.0
