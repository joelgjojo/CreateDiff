# ==============================================================================
# CreateDiff Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# NOTE: Never commit .env to version control!
# ==============================================================================

# Local backend URL for development.
# Android emulator: http://10.0.2.2:8000
# Physical Android device: http://<YOUR_MAC_LAN_IP>:8000
CREATE_DIFF_DEV_API_BASE_URL=http://10.0.2.2:8000

# Production is supplied separately at build time, for example:
# flutter build apk --release \
#   --dart-define=CREATE_DIFF_PRODUCTION_API_BASE_URL=https://your-api.example.com
