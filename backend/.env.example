# ==============================================================================
# CreateDiff FastAPI Backend Environment Configuration
# ==============================================================================

# Server Environment (development | staging | production)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Groq AI Configuration (Server-Side Only - Never Exposed to Flutter Client)
GROQ_API_KEY=[REDACTED]
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Security & CORS (Comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# In-Memory IP Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Request Limits
MAX_REQUEST_BODY_BYTES=65536
MAX_PROMPT_LENGTH=2000

# Groq HTTP Client Timeouts (seconds)
GROQ_CONNECT_TIMEOUT=10.0
GROQ_READ_TIMEOUT=35.0
GROQ_TOTAL_TIMEOUT=45.0

# Phase 3 authentication and persistence (server-side only)
AUTH_REQUIRED=false
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=["HS256"]
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DB_AUTO_CREATE=false
USAGE_GENERATION_LIMIT=100
USAGE_CAMPAIGN_LIMIT=20
USAGE_AI_REQUEST_LIMIT=150

# Multi-instance scaling: move quota checks to transactional Redis counters.
