# ==============================================================================
# CreateDiff Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# NOTE: Never commit .env to version control!
# ==============================================================================

# xAI Grok / Groq API Key (starts with "gsk_" for Groq or "xai-" for xAI)
GROK_API_KEY=gsk_your_api_key_here

# Base URL (default: https://api.groq.com/openai/v1 or https://api.x.ai/v1)
GROK_BASE_URL=https://api.groq.com/openai/v1

# AI Model Name (default: llama-3.3-70b-versatile or grok-beta)
GROK_MODEL=llama-3.3-70b-versatile
